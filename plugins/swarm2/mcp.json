{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "swarm2": {
      "type": "streamable-http",
      "url": "https://swarm2-mcp.netconnect.ro/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationUrl": "https://auth.netconnect.ro/auth/realms/netconnect/protocol/openid-connect/auth",
            "tokenUrl": "https://auth.netconnect.ro/auth/realms/netconnect/protocol/openid-connect/token",
            "resource": "https://swarm2-mcp.netconnect.ro/mcp",
            "defaultScopes": ["openid", "email", "profile", "offline_access"],
            "client": {
              "mode": "provided",
              "clientId": "swarm2-mcp",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
